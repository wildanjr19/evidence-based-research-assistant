# Salin ke .env lalu isi nilainya. Jangan commit .env (sudah di-gitignore).
# Hanya isi key yang provider-nya dipakai.
# Generation membaca key dari .env di direktori kerja bila tidak ada di environment.

# LLM generator
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Parser (opsional; hanya dipakai bila GROBID ditambahkan di v2)
GROBID_URL=http://localhost:8070
